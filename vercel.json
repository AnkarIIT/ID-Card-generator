{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    }
  ],
  "functions": {
    "server.ts": {
      "maxDuration": 10,
      "memory": 512
    }
  },
  "resetPoint": true
}